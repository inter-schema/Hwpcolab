    {
      "sec": 0,
      "para": 79,
      "ctrl": 0,
      "rowCount": 4,
      "colCount": 2,
      "cells": [
        {
          "idx": 0,
          "row": 0,
          "col": 0,
          "rowSpan": 1,
          "colSpan": 1,
          "text": "구분"
        },
        {
          "idx": 1,
