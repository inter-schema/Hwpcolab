{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@/core/font-loader": ["./src/hop-host/core/font-loader.ts"],
      "@/core/font-authoring-policy": ["./src/hop-host/core/font-authoring-policy.ts"],
      "@/core/local-fonts": ["./src/hop-host/core/local-fonts.ts"],
      "@/core/bridge-factory": ["./src/hop-host/core/bridge-factory.ts"],
      "@/core/document-files": ["./src/hop-host/core/document-files.ts"],
      "@/core/desktop-chrome": ["./src/hop-host/core/desktop-chrome.ts"],
      "@/core/desktop-events": ["./src/hop-host/core/desktop-events.ts"],
      "@/core/platform": ["./src/hop-host/core/platform.ts"],
      "@/core/tauri-bridge": ["./src/hop-host/core/tauri-bridge.ts"],
      "@/command/shortcut-map": ["./src/hop-host/command/shortcut-map.ts"],
      "@/command/commands/edit": ["./src/hop-host/command/commands/edit.ts"],
      "@/command/commands/file": ["./src/hop-host/command/commands/file.ts"],
      "@/command/commands/table": ["./src/hop-host/command/commands/table.ts"],
      "@/ui/about-dialog": ["./src/hop-host/ui/about-dialog.ts"],
      "@/ui/custom-select": ["./src/hop-host/ui/custom-select.ts"],
      "@/ui/dialog": ["./src/hop-host/ui/dialog.ts"],
      "@/ui/home-screen": ["./src/hop-host/ui/home-screen.ts"],
      "@/ui/preview-svg": ["./src/hop-host/ui/preview-svg.ts"],
      "@/ui/print-dialog": ["./src/hop-host/ui/print-dialog.ts"],
      "@/ui/recent-documents-dialog": ["./src/hop-host/ui/recent-documents-dialog.ts"],
      "@/ui/toolbar": ["./src/hop-host/ui/toolbar.ts"],
      "@/ui/update-notice": ["./src/hop-host/ui/update-notice.ts"],
      "@/upstream/*": ["./src/hop-host/upstream/*"],
      "@/*": ["./third_party/rhwp/rhwp-studio/src/*"],
      "@upstream/*": ["./third_party/rhwp/rhwp-studio/src/*"],
      "@wasm/*": ["./public/vendor/rhwp/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
